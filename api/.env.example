# Supabase server-side credentials. Copy to .env and fill from `supabase status`
# (local) or the project dashboard (cloud). NEVER commit .env.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Comma-separated CORS allowlist (already read by main.py)
ALLOWED_ORIGINS=http://localhost:5173
